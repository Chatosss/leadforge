# Copie para .env e preencha. O .env não vai para o git.

# IA principal (diagnóstico, atendimento). Qualquer API no padrão OpenAI.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# IA que personaliza cada mensagem (9router ou outra API no padrão OpenAI).
# IA_MSG_MODELOS: ordem de tentativa, separada por vírgula.
IA_MSG_URL=http://127.0.0.1:20128/v1
IA_MSG_KEY=
IA_MSG_MODELOS=

# Modo teste: só estes contatos recebem (separados por vírgula).
MODO_TESTE_WHATSAPP=
MODO_TESTE_INSTAGRAM=
MODO_TESTE_EMAIL=

# E-mail
EMAIL_NOME=Seu Nome - Sua Empresa
EMAIL_EXCLUIR=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=

# Opcionais
PAGESPEED_API_KEY=
MAPS_DB_ORIGEM=

# Relé do webhook do Instagram (API oficial; opcional)
IG_RELE_FTP_HOST=
IG_RELE_FTP_USUARIO=
IG_RELE_SITE=
